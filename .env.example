# Copy this file to .env and replace the placeholder values.
# NEVER commit .env to git.

# --- OpenAI (https://platform.openai.com/api-keys) ---
OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-4.1-mini
# Model used by the hallucination judge (defaults to OPENAI_MODEL if empty)
OPENAI_JUDGE_MODEL=gpt-4.1-mini

# --- Langfuse (Langfuse UI > Project Settings > API Keys) ---
LANGFUSE_PUBLIC_KEY=replace-me
LANGFUSE_SECRET_KEY=replace-me
# EU cloud: https://cloud.langfuse.com   US cloud: https://us.cloud.langfuse.com
# Self-hosted: your own URL
LANGFUSE_BASE_URL=https://cloud.langfuse.com
